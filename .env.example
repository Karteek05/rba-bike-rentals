APP_ENV=development
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
APP_CITY=bengaluru
ALLOW_DEV_HEADERS=false
JOB_SECRET=replace_job_secret

# Auth
BETTER_AUTH_SECRET=replace_with_32_plus_char_random_secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=/api/auth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_VEHICLE_IMAGE_BUCKET=vehicle-images

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Dashboard password gate for /admin and /partner.
# Use strong unique values in staging/production.
DASHBOARD_ACCESS_SECRET=replace_with_32_plus_char_random_secret
ADMIN_DASHBOARD_PASSWORD=replace_admin_password
PARTNER_DASHBOARD_PASSWORD=replace_partner_password
# Prefer *_SHA256 in staging/production so raw dashboard passwords are not stored.
# Generate with: node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('your-password')).then(b=>console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')))"
ADMIN_DASHBOARD_PASSWORD_SHA256=
PARTNER_DASHBOARD_PASSWORD_SHA256=
ADMIN_DASHBOARD_USER_ID=admin_001
PARTNER_DASHBOARD_USER_ID=partner_001

# Setu DigiLocker
SETU_DIGILOCKER_BASE_URL=https://dg.setu.co
SETU_CLIENT_ID=replace_me
SETU_CLIENT_SECRET=replace_me
SETU_PRODUCT_INSTANCE_ID=replace_me
SETU_REDIRECT_URL=https://rbabikerentals.com/kyc/callback
SETU_WEBHOOK_SECRET=replace_me

# CIBIL
CIBIL_PROVIDER_MODE=mock
CIBIL_API_URL=
CIBIL_API_KEY=
CIBIL_HIGH_RISK_BELOW=650
CIBIL_MEDIUM_RISK_BELOW=700

# Google Maps Platform
GOOGLE_MAPS_API_KEY=replace_me

# Notifications
NOTIFICATION_PROVIDER=mock
SMTP_HOST=replace_me
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
EMAIL_FROM=ops@rbabikerentals.com
ADMIN_EMAIL=admin@rbabikerentals.com
WHATSAPP_SENDER_ID=replace_me
SMS_SENDER_ID=replace_me
